DATABASE_URL=mysql+pymysql://agent_ro:agent_ro_pw@127.0.0.1:3306/shop
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# answer model: explanations, chart plans, conversation memory. A THINKING model (qwen3:4b) reasons before it
# answers, which helps with abstract questions; qwen3:8b is stronger but ~2x slower, qwen2.5:7b-instruct is the
# non-thinking alternative. Empty = same as OLLAMA_MODEL.
OLLAMA_ANSWER_MODEL=qwen3:4b
MAX_ROWS=1000
MAX_SQL_RETRIES=3
MAX_TABLES_IN_PROMPT=6
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0
# Power BI export: "live" = .pbip queries MySQL with the generated SQL, "inline" = rows embedded in the file
POWERBI_SOURCE=live
POWERBI_INLINE_MAX_ROWS=5000
# Netlify personal access token for publishing dashboards (User settings > Applications). Empty = publishing off
NETLIFY_AUTH_TOKEN=
# Expert AI: the model that plans the data and assesses results. A thinking model is recommended (qwen3:4b for
# speed, qwen3:8b for better judgement). Empty = answer model.
OLLAMA_EXPERT_MODEL=qwen3:4b
# Model names matching this regex run with thinking on and get the longer LLM_THINK_TIMEOUT_S (seconds)
OLLAMA_THINKING_MODELS=qwen3|deepseek-r1|gpt-oss|magistral|phi4-reasoning
LLM_THINK_TIMEOUT_S=900
# One or two sentences about your domain and goals, injected into every expert prompt (editable in the sidebar)
EXPERT_PERSONA=
# Agents: default on/off for the sidebar "Agents" switches (1 = on). Each one is a model call per question.
STANDARDISE_REQUESTS=1
EXPERT_REVIEWS=1
# EXPERT_PLAN=1 / EXPERT_ASSESS=1 override the two expert steps separately
SUMMARISE_DATA_QUERIES=1
DRAW_CHARTS=1
REMEMBER_CONVERSATION=1
